+def validate_adaptive_spec_deepep_dispatch_budget(server_args: Any) -> None:
+    """Adaptive spec under DP attention: every tier must fit the DeepEP low-latency buffer."""
+    view = resolved_view(server_args)
+    if not (
+        view.speculative_adaptive
+        and view.enable_dp_attention
+        and view.moe_a2a_backend == "deepep"
+        and view.deepep_mode in ("low_latency", "auto")
+        and view.disaggregation_mode != "prefill"
+    ):
+        return
+    from sglang.srt.speculative.adaptive_spec_params import (
+        adaptive_slot_candidate_steps,
+        peak_decode_dispatch_tokens,
+    )
+
+    decode_config = view.cuda_graph_config.decode
+    graph_enabled = decode_config.backend != Backend.DISABLED
+    capture_bs = None
+    if graph_enabled:
+        from sglang.srt.arg_groups.cuda_graph_hook import (
+            generate_decode_cuda_graph_batch_sizes,
+        )
+
+        capture_bs = decode_config.bs or generate_decode_cuda_graph_batch_sizes(
+            server_args, decode_config.max_bs
+        )
+    if view.max_running_requests is not None:
+        max_bs_per_rank = max(1, view.max_running_requests // view.dp_size)
+    elif capture_bs:
+        # A memory-derived pool leaves the eager range to the runtime DeepEP assert.
+        max_bs_per_rank = max(capture_bs)
+    else:
+        return
+
+    peak = peak_decode_dispatch_tokens(
+        slot_candidate_steps=adaptive_slot_candidate_steps(
+            view.speculative_adaptive_config
+        ),
+        # Same routing list as the DP consensus (_adaptive_decode_cuda_graph_bs).
+        routing_cuda_graph_bs=view.cuda_graph_bs_decode if graph_enabled else None,
+        capture_cuda_graph_bs=capture_bs,
+        max_bs_per_rank=max_bs_per_rank,
+    )
+    capacity = envs.SGLANG_DEEPEP_NUM_MAX_DISPATCH_TOKENS_PER_RANK.get()
+    if peak.num_tokens > capacity:
+        raise ValueError(
+            "--speculative-adaptive with DP attention: the DeepEP low-latency "
+            f"decode dispatch needs {peak.num_tokens} tokens per rank "
+            f"(max per-rank bs {peak.max_decode_bs}, graph bs {peak.graph_bs}, "
+            f"slot {peak.slot_bs} steps={peak.num_steps}, "
+            f"{peak.num_steps + 1} tokens per request) but "
+            f"SGLANG_DEEPEP_NUM_MAX_DISPATCH_TOKENS_PER_RANK={capacity}. Raise "
+            "SGLANG_DEEPEP_NUM_MAX_DISPATCH_TOKENS_PER_RANK, remove the deep steps "
+            f"from slot {peak.slot_bs} in --speculative-adaptive-config, or lower "
+            "--max-running-requests / --cuda-graph-max-bs-decode."
+        )
+
+
 def validate_deepep_v2_model_architecture(server_args: Any) -> None:
     """Allow DeepEP v2 only for registered model architectures."""
 
