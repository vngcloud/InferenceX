diff --git a/python/sglang/srt/speculative/dp_adaptive_consensus.py b/python/sglang/srt/speculative/dp_adaptive_consensus.py
new file mode 100644
index 0000000000..833c88af51
--- /dev/null
+++ b/python/sglang/srt/speculative/dp_adaptive_consensus.py
@@ -0,0 +1,338 @@
+"""DP-attention consensus for adaptive speculative decoding.
+
+Every DP rank feeds the same all-gathered per-rank signals into
+``resolve_consensus_steps`` and gets the same ``num_steps``, so no rank can
+diverge from the others' draft forward count or verify width.
+"""
+
+from __future__ import annotations
+
+import logging
+from collections.abc import Sequence
+
+import msgspec
+
+from sglang.srt.speculative.adaptive_spec_params import (
+    AdaptiveStepSlot,
+    _load_adaptive_config,
+    find_closest_slot_bs,
+    pad_to_cuda_graph_bs,
+)
+from sglang.srt.utils import log_info_on_rank0
+
+logger = logging.getLogger(__name__)
+
+# Appended after the existing MLPSyncBatchInfo columns, in SpecCounters.to_columns order.
+NUM_CONSENSUS_COLUMNS = 3
+
+
+class RankSpecSignals(msgspec.Struct, frozen=True, kw_only=True):
+    """One rank's row of the consensus gather."""
+
+    decode_bs: int
+    is_extend: bool
+    correct_draft_ct: int
+    verify_req_ct: int
+    counter_steps: int
+
+    @classmethod
+    def from_gather_row(
+        cls, *, num_tokens: int, is_extend: bool, counter_columns: Sequence[int]
+    ) -> RankSpecSignals:
+        correct_draft_ct, verify_req_ct, counter_steps = counter_columns
+        return cls(
+            decode_bs=0 if is_extend else int(num_tokens),
+            is_extend=bool(is_extend),
+            correct_draft_ct=int(correct_draft_ct),
+            verify_req_ct=int(verify_req_ct),
+            counter_steps=int(counter_steps),
+        )
+
+
+class SpecCounters(msgspec.Struct, frozen=True, kw_only=True):
+    """A rank's cumulative verify counters; all-zero doubles as the fallback row."""
+
+    correct_draft_ct: int = 0
+    verify_req_ct: int = 0
+    counter_steps: int = 0
+
+    def to_columns(self) -> list[int]:
+        return [self.correct_draft_ct, self.verify_req_ct, self.counter_steps]
+
+    def add_verify(
+        self, *, num_correct_drafts_per_req: Sequence[int], num_steps: int
+    ) -> SpecCounters:
+        if not num_correct_drafts_per_req:
+            return self
+        return SpecCounters(
+            correct_draft_ct=self.correct_draft_ct + sum(num_correct_drafts_per_req),
+            verify_req_ct=self.verify_req_ct + len(num_correct_drafts_per_req),
+            counter_steps=num_steps,
+        )
+
+
+class SlotState(msgspec.Struct, frozen=True, kw_only=True):
+    current_steps: int
+    ema_accept_len: float
+    batch_count: int
+
+
+class ConsensusState(msgspec.Struct, frozen=True, kw_only=True):
+    steps: int
+    slots: tuple[SlotState, ...]
+    dwell_left: int
+    prev_correct_draft_cts: tuple[int, ...]
+    prev_verify_req_cts: tuple[int, ...]
+
+
+class ConsensusPolicy(msgspec.Struct, frozen=True, kw_only=True):
+    slot_bs: tuple[int, ...]
+    slot_cfgs: tuple[dict, ...]
+    min_dwell_batches: int
+    cuda_graph_bs: tuple[int, ...] | None
+
+    @classmethod
+    def from_config(
+        cls, *, cfg_path: str | None, cuda_graph_bs: list[int] | None
+    ) -> ConsensusPolicy:
+        cfg, bs_entries = _load_adaptive_config(cfg_path)
+        slot_bs = tuple(sorted(bs_entries))
+        return cls(
+            slot_bs=slot_bs,
+            slot_cfgs=tuple({**cfg, **bs_entries[bs]} for bs in slot_bs),
+            min_dwell_batches=_load_min_dwell_batches(cfg),
+            cuda_graph_bs=tuple(sorted(cuda_graph_bs)) if cuda_graph_bs else None,
+        )
+
+    def initial_state(self, *, initial_steps: int, num_ranks: int) -> ConsensusState:
+        return ConsensusState(
+            steps=initial_steps,
+            slots=tuple(
+                _slot_state(AdaptiveStepSlot(initial_steps=initial_steps, cfg=c))
+                for c in self.slot_cfgs
+            ),
+            dwell_left=0,
+            prev_correct_draft_cts=(0,) * num_ranks,
+            prev_verify_req_cts=(0,) * num_ranks,
+        )
+
+
+def resolve_consensus_steps(
+    *,
+    signals: Sequence[RankSpecSignals],
+    state: ConsensusState,
+    policy: ConsensusPolicy,
+) -> tuple[int, ConsensusState]:
+    """Return the ``num_steps`` every rank runs this iteration, and the next state."""
+    slot_idx = _route_slot(
+        policy=policy, max_decode_bs=max(s.decode_bs for s in signals)
+    )
+    if any(s.is_extend for s in signals):
+        return _mixed_iteration_steps(
+            state=state, policy=policy, slot_idx=slot_idx
+        ), state
+    if all(s.decode_bs == 0 for s in signals):
+        return state.steps, state
+
+    feedback, state = _consume_fresh_feedback(signals=signals, state=state)
+    slot = state.slots[slot_idx]
+    if feedback is not None:
+        slot = _feed_slot(
+            slot=slot, cfg=policy.slot_cfgs[slot_idx], mean_correct_drafts=feedback
+        )
+    return _commit_steps(
+        state=state,
+        slot_idx=slot_idx,
+        slot=slot,
+        candidate_steps=policy.slot_cfgs[slot_idx]["candidate_steps"],
+        min_dwell_batches=policy.min_dwell_batches,
+        has_feedback=feedback is not None,
+    )
+
+
+class DPAdaptiveConsensus:
+    """One scheduler's consensus state plus this rank's cumulative counters.
+
+    The verify hook only accumulates counters; the tier changes only through
+    ``resolve`` on the gathered rows, which every DP rank calls identically.
+    """
+
+    def __init__(self, *, policy: ConsensusPolicy, initial_steps: int, num_ranks: int):
+        self._policy = policy
+        self._state = policy.initial_state(
+            initial_steps=initial_steps, num_ranks=num_ranks
+        )
+        self.local_counters = SpecCounters()
+        # Scheduler metrics: committed tier switches, and the pooled EMA of
+        # correct drafts per verified request of the last fed slot (0 until fed).
+        self.switch_ct = 0
+        self.correct_drafts_ema = 0.0
+
+    @classmethod
+    def from_config(
+        cls,
+        *,
+        cfg_path: str | None,
+        cuda_graph_bs: list[int] | None,
+        initial_steps: int,
+        num_ranks: int,
+    ) -> DPAdaptiveConsensus:
+        policy = ConsensusPolicy.from_config(
+            cfg_path=cfg_path, cuda_graph_bs=cuda_graph_bs
+        )
+        log_info_on_rank0(
+            logger,
+            f"Adaptive spec DP consensus initialized: steps={initial_steps}, "
+            f"num_ranks={num_ranks}, slot_bs={list(policy.slot_bs)}, "
+            f"min_dwell_batches={policy.min_dwell_batches}",
+        )
+        return cls(policy=policy, initial_steps=initial_steps, num_ranks=num_ranks)
+
+    def record_verify(
+        self, *, num_correct_drafts_per_req: Sequence[int], num_steps: int
+    ) -> None:
+        self.local_counters = self.local_counters.add_verify(
+            num_correct_drafts_per_req=num_correct_drafts_per_req,
+            num_steps=num_steps,
+        )
+
+    def resolve(self, signals: Sequence[RankSpecSignals]) -> int:
+        num_ranks = len(self._state.prev_verify_req_cts)
+        if len(signals) != num_ranks:
+            raise RuntimeError(
+                f"Adaptive spec DP consensus expects {num_ranks} gathered rows, "
+                f"got {len(signals)}"
+            )
+        prev_state = self._state
+        prev_steps = prev_state.steps
+        steps, self._state = resolve_consensus_steps(
+            signals=signals, state=self._state, policy=self._policy
+        )
+        self.correct_drafts_ema = next(
+            (
+                new.ema_accept_len
+                for old, new in zip(prev_state.slots, self._state.slots)
+                if new.batch_count != old.batch_count
+            ),
+            self.correct_drafts_ema,
+        )
+        # Mixed iterations may return a temporary width; log committed switches only.
+        if self._state.steps != prev_steps:
+            self.switch_ct += 1
+            ema = [round(s.ema_accept_len, 2) for s in self._state.slots]
+            log_info_on_rank0(
+                logger,
+                f"Adaptive spec params updated: steps {prev_steps} -> "
+                f"{self._state.steps} (DP consensus, slot ema_accept_len={ema})",
+            )
+        return steps
+
+
+def _load_min_dwell_batches(cfg: dict) -> int:
+    min_dwell_batches = cfg.get("min_dwell_batches", 0)
+    if not isinstance(min_dwell_batches, int) or min_dwell_batches < 0:
+        raise ValueError(
+            f"min_dwell_batches must be a non-negative int, got {min_dwell_batches!r}"
+        )
+    return min_dwell_batches
+
+
+def _route_slot(*, policy: ConsensusPolicy, max_decode_bs: int) -> int:
+    padded = pad_to_cuda_graph_bs(
+        batch_size=max_decode_bs,
+        cuda_graph_bs=None
+        if policy.cuda_graph_bs is None
+        else list(policy.cuda_graph_bs),
+    )
+    return policy.slot_bs.index(
+        find_closest_slot_bs(target=padded, slot_bs=list(policy.slot_bs))
+    )
+
+
+def _mixed_iteration_steps(
+    *, state: ConsensusState, policy: ConsensusPolicy, slot_idx: int
+) -> int:
+    """Prefill coordination needs a positive verify width every rank agrees on."""
+    if state.steps > 0:
+        return state.steps
+    positive = [s for s in policy.slot_cfgs[slot_idx]["candidate_steps"] if s > 0]
+    if not positive:
+        positive = [s for c in policy.slot_cfgs for s in c["candidate_steps"] if s > 0]
+    return min(positive, default=0)
+
+
+def _consume_fresh_feedback(
+    *, signals: Sequence[RankSpecSignals], state: ConsensusState
+) -> tuple[float | None, ConsensusState]:
+    """Pool this gather's counter deltas produced under the committed tier.
+
+    Returns the mean correct drafts per verified request, or None when no
+    fresh request was verified, plus the state with the per-rank totals advanced.
+    """
+    num_correct_drafts = 0
+    num_verify_reqs = 0
+    for rank, s in enumerate(signals):
+        delta_correct = s.correct_draft_ct - state.prev_correct_draft_cts[rank]
+        delta_verify = s.verify_req_ct - state.prev_verify_req_cts[rank]
+        # A decrease means the rank reset its counters; drop that delta.
+        if s.counter_steps == state.steps and delta_correct >= 0 and delta_verify >= 0:
+            num_correct_drafts += delta_correct
+            num_verify_reqs += delta_verify
+    # A row that never verified is a fallback row; keep the last real totals.
+    reported = [s.verify_req_ct > 0 for s in signals]
+    state = msgspec.structs.replace(
+        state,
+        prev_correct_draft_cts=tuple(
+            s.correct_draft_ct if r else prev
+            for s, r, prev in zip(signals, reported, state.prev_correct_draft_cts)
+        ),
+        prev_verify_req_cts=tuple(
+            s.verify_req_ct if r else prev
+            for s, r, prev in zip(signals, reported, state.prev_verify_req_cts)
+        ),
+    )
+    if num_verify_reqs == 0:
+        return None, state
+    return num_correct_drafts / num_verify_reqs, state
+
+
+def _feed_slot(*, slot: SlotState, cfg: dict, mean_correct_drafts: float) -> SlotState:
+    policy_slot = AdaptiveStepSlot(initial_steps=slot.current_steps, cfg=cfg)
+    policy_slot.ema_accept_len = slot.ema_accept_len
+    policy_slot.batch_count = slot.batch_count
+    policy_slot.update_mean(mean_correct_drafts)
+    return _slot_state(policy_slot)
+
+
+def _commit_steps(
+    *,
+    state: ConsensusState,
+    slot_idx: int,
+    slot: SlotState,
+    candidate_steps: list[int],
+    min_dwell_batches: int,
+    has_feedback: bool,
+) -> tuple[int, ConsensusState]:
+    # A slot that cannot run the committed tier has no graphs for it,
+    # so leaving it bypasses the dwell window.
+    if state.dwell_left > 0 and state.steps in candidate_steps:
+        slot = msgspec.structs.replace(slot, current_steps=state.steps)
+    steps = slot.current_steps
+    if steps != state.steps:
+        dwell_left = min_dwell_batches
+    elif has_feedback:
+        dwell_left = max(0, state.dwell_left - 1)
+    else:
+        dwell_left = state.dwell_left
+    slots = state.slots[:slot_idx] + (slot,) + state.slots[slot_idx + 1 :]
+    return steps, msgspec.structs.replace(
+        state, steps=steps, slots=slots, dwell_left=dwell_left
+    )
+
+
+def _slot_state(slot: AdaptiveStepSlot) -> SlotState:
+    return SlotState(
+        current_steps=slot.current_steps,
+        ema_accept_len=slot.ema_accept_len,
+        batch_count=slot.batch_count,
+    )
