+    routing_cuda_graph_bs: list[int] | None,
+    capture_cuda_graph_bs: list[int] | None,
+    max_bs_per_rank: int,
+) -> DecodeDispatchPeak:
+    """Scan every max per-rank decode bs a DP gather can carry, up to *max_bs_per_rank*."""
+    slot_bs = sorted(slot_candidate_steps)
+    routing_bs = sorted(routing_cuda_graph_bs) if routing_cuda_graph_bs else None
+    capture_bs = sorted(capture_cuda_graph_bs) if capture_cuda_graph_bs else None
+    peak = None
+    for max_decode_bs in range(1, max_bs_per_rank + 1):
+        slot = find_closest_slot_bs(
+            target=pad_to_cuda_graph_bs(
+                batch_size=max_decode_bs, cuda_graph_bs=routing_bs
+            ),
+            slot_bs=slot_bs,
+        )
+        num_steps = max(slot_candidate_steps[slot])
+        # tokens/rank = pad_graph(max per-rank bs, eager: unpadded) x (slot's max step + 1)
