+def pad_to_cuda_graph_bs(*, batch_size: int, cuda_graph_bs: list[int] | None) -> int:
+    """Pad *batch_size* up to the next captured graph bs; unchanged past the largest."""
+    if cuda_graph_bs is None:
+        return batch_size
+    idx = bisect.bisect_left(cuda_graph_bs, batch_size)
+    return cuda_graph_bs[idx] if idx < len(cuda_graph_bs) else batch_size
+
+
+def find_closest_slot_bs(*, target: int, slot_bs: list[int]) -> int:
+    """Largest slot bs <= *target*, or the smallest slot when none is."""
+    idx = bisect.bisect_right(slot_bs, target) - 1
+    return slot_bs[max(0, idx)]
+
